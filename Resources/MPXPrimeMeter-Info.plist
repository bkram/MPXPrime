<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded into the MPXPrimeMeter Mach-O via a __TEXT,__info_plist linker
  section (see Package.swift). Makes LaunchServices read the display name
  from the bare executable so a `swift run MPXPrimeMeter` / direct
  .build/release/MPXPrimeMeter launch shows "MPX Prime Meter" in the Apple
  menu and Dock instead of the SPM target name. The shipped .app bundle has
  its own Contents/Info.plist (generated by build-release.sh) which takes
  precedence when bundled. Keep the identity keys in sync with that.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MPX Prime Meter</string>
    <key>CFBundleDisplayName</key>
    <string>MPX Prime Meter</string>
    <key>CFBundleExecutable</key>
    <string>MPXPrimeMeter</string>
    <key>CFBundleIdentifier</key>
    <string>com.mpxprime.meter</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
</dict>
</plist>
