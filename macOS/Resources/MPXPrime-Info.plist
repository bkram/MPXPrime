<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Embedded into the MPXPrime Mach-O via a __TEXT,__info_plist linker
  section (see Package.swift). This makes LaunchServices read the app's
  display name from the bare executable too, so a `swift run` / direct
  `.build/release/MPXPrime` launch shows "MPX Prime Studio" in the Apple
  menu and the Dock -- not the SPM target name "MPXPrime" (target names cannot
  contain spaces). The shipped .app bundle has its own Contents/Info.plist
  generated by build-release.sh, which takes precedence when bundled; this
  section only governs the unbundled-binary case. Keep the identity keys in
  sync with build-release.sh.
-->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>MPX Prime Studio</string>
    <key>CFBundleDisplayName</key>
    <string>MPX Prime Studio</string>
    <key>CFBundleExecutable</key>
    <string>MPXPrime</string>
    <key>CFBundleIdentifier</key>
    <string>com.mpxprime.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
</dict>
</plist>
