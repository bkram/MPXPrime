  "stages": [
   {
    "help": "One picker that atomically wires multiband, final stage, PrimeBass, widener and composite-clipper settings to a coherent target for a programming format. Per-stage knobs stay editable afterwards; 'Custom' records that your settings are bespoke.",
    "id": "profile",
    "keys": [],
    "pill": null,
    "presetKind": "format_profile",
    "sub": "Station format bundle",
    "title": "Profile"
   },
   {
    "help": "Global engine controls: bypass, mono mode, input/output gains, pre-emphasis, audio HPF, program lowpass, HF trim. Most settings here are restart-required.",
    "id": "core",
    "keys": [
     "processing_bypass",
     "mono_mode",
     "preemphasis_us",
     "input_gain_db",
     "output_gain_db",
     "mpx_line_output_dbfs",
