     "hf_trim_hz",
     "program_lowpass_hz"
    ],
    "keys2": {
     "keys": [
      "encoder_fir_enabled",
      "multiband_fir_enabled"
     ],
     "title": "Engine - Filters"
    },
    "pill": "Core",
    "sub": "Bypass, mono, gains, HPF, LPF, HF trim",
    "title": "Core"
   },
   {
    "enable": "phase_rotation_enabled",
    "help": "4-pole allpass chain that reduces waveform asymmetry \u2014 especially on voice \u2014 by 3-4 dB without changing tonal balance. Frees headroom for downstream dynamics stages.",
